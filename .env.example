# 复制为 .env.local。真实密钥只保存在本机，不使用 NEXT_PUBLIC_ 前缀。
# mock 不调用模型；填写密钥并切换 live 后，用户触发提取/审查才发送内容。
AI_MODE=mock

# DeepSeek 官方兼容接口（2026-11-12 核对）；也支持替换兼容服务。
AI_PROVIDER=deepseek
AI_BASE_URL=https://api.deepseek.com
AI_MODEL=deepseek-flash
AI_API_KEY=
AI_TIMEOUT_MS=60000
AI_MAX_CALLS_PER_REVIEW=12

NEXT_TELEMETRY_DISABLED=1

# 可选本地多身份访问：JSON 数组，第一位接管已有单机任务。
# 每个 token 使用独立随机值（至少32字符），不要使用示例或真实 API 密钥。
# 不配置时仅适用于本机单用户。配置后访问 /access 登录；任务页由所有者管理授权。
REVIEW_ACCESS_USERS=

# 非 Windows x64 或需要替换媒体工具时填写绝对路径；留空时 Windows 使用可选依赖。
FFMPEG_PATH=
FFPROBE_PATH=
