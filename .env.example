# 复制为 .env.local。真实密钥只保存在本机，不使用 NEXT_PUBLIC_ 前缀。
# mock 不调用模型；填写密钥并切换 live 后，用户触发提取/审查才发送内容。
AI_MODE=mock

# DeepSeek 官方兼容接口（2026-11-12 核对）；也支持替换兼容服务。
AI_PROVIDER=deepseek
AI_BASE_URL=https://api.deepseek.com
AI_MODEL=deepseek-flash
AI_API_KEY=
AI_TIMEOUT_MS=60000
AI_MAX_CALLS_PER_REVIEW=12

NEXT_TELEMETRY_DISABLED=1

# 产品入口固定使用用户名+密码，注册后保存恢复码；管理员在本机显式授权。
# 旧 REVIEW_ACCESS_USERS 仅供独立 legacy-test 回归，不作为产品登录配置。
# 旧任务不会自动交给新用户，迁移见 docs/platform-operation.md。
EXAM_SCHEDULER=on

# 助手单独停用不影响公告和学习资料；每账号每小时问题数1—200，默认20。
ASSISTANT_ENABLED=on
ASSISTANT_HOURLY_LIMIT=20
AUTO_REVIEW_ENABLED=on
# 每账号滚动24小时自动任务上限1—20，包含用户明确重试，默认5。
AUTO_REVIEW_DAILY_LIMIT=5

# 非 Windows x64 或需要替换媒体工具时填写绝对路径；留空时 Windows 使用可选依赖。
FFMPEG_PATH=
FFPROBE_PATH=
