{
  "name": "material-review-agent",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.25.0",
  "engines": {
    "node": ">=24 <25",
    "pnpm": ">=11 <12"
  },
  "scripts": {
    "dev": "next dev --webpack --hostname 127.0.0.1",
    "build": "next build --webpack",
    "start": "next start --hostname 127.0.0.1",
    "lint": "eslint . --max-warnings 0",
    "typecheck": "next typegen && tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "pnpm lint && pnpm typecheck && pnpm format:check && pnpm test:unit",
    "test:unit": "node --test tests/unit/*.test.mjs",
    "test:ui": "playwright test --ui --ui-host 127.0.0.1",
    "test:e2e": "node scripts/reset-e2e-database.mjs && node scripts/seed-e2e-v1-database.mjs && playwright test",
    "test:model": "playwright test --config=playwright.live.config.ts",
    "test:report": "playwright show-report --host 127.0.0.1",
    "test:install": "playwright install chromium",
    "git:setup": "node scripts/setup-git.mjs",
    "commit:check": "node scripts/validate-commit.mjs",
    "test:access": "playwright test --config=playwright.access.config.ts"
  },
  "dependencies": {
    "@ai-sdk/openai-compatible": "3.0.90",
    "@napi-rs/canvas": "1.1.0",
    "@tesseract.js-data/chi_sim": "1.0.0",
    "@tesseract.js-data/eng": "1.0.0",
    "ai": "7.0.169",
    "better-sqlite3": "13.0.3",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "csv-parse": "7.0.3",
    "exceljs": "4.4.0",
    "file-type": "22.3.0",
    "jszip": "3.10.2",
    "lucide-react": "1.72.0",
    "mammoth": "1.13.0",
    "next": "16.4.6",
    "parse5": "^8.1.1",
    "pdfjs-dist": "6.5.438",
    "radix-ui": "1.8.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "server-only": "0.0.1",
    "sharp": "0.35.5",
    "tailwind-merge": "3.7.0",
    "tesseract.js": "7.0.0",
    "undici": "^8.12.4",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@eslint/js": "10.0.1",
    "@next/eslint-plugin-next": "16.4.6",
    "@playwright/test": "1.65.0",
    "@tailwindcss/postcss": "4.3.5",
    "@types/better-sqlite3": "9.6.0",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "eslint": "10.14.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "17.14.0",
    "prettier": "3.9.10",
    "tailwindcss": "4.3.5",
    "typescript": "5.9.3",
    "typescript-eslint": "8.72.2"
  },
  "optionalDependencies": {
    "@ffmpeg-installer/win32-x64": "4.1.0",
    "@ffprobe-installer/win32-x64": "5.1.0"
  }
}
